  "topic_content": [
    {
      "name": "Механическое движение",
      "subject": "Физика",
      "grade_level": 7,
      "description": "При равномерном движении скорость постоянна: $v=\\frac{s}{t}$. Отсюда $s=vt$ и $t=\\frac{s}{v}$.",
      "subtopics": {
        "Скорость": "Скорость показывает, какой путь проходит тело за единицу времени. Перед вычислениями величины следует привести к согласованным единицам."
      }
    },
    {
      "name": "Масса и плотность",
      "subject": "Физика",
      "grade_level": 7,
      "description": "Плотность вещества определяется формулой $\\rho=\\frac{m}{V}$. В СИ плотность измеряется в $\\text{кг/м}^3$.",
      "subtopics": {
        "Плотность вещества": "Из основной формулы следуют выражения $m=\\rho V$ и $V=\\frac{m}{\\rho}$."
      }
    },
    {
      "name": "Количество теплоты",
      "subject": "Физика",
      "grade_level": 8,
      "description": "При нагревании или охлаждении без изменения агрегатного состояния количество теплоты вычисляется по формуле $Q=cm\\Delta T$.",
      "subtopics": {
        "Количество теплоты. Удельная теплоёмкость": "Удельная теплоёмкость показывает, сколько энергии нужно для нагревания $1\\,\\text{кг}$ вещества на $1\\,^{\\circ}\\text{C}$."
      }
    },
    {
      "name": "Постоянный ток",
      "subject": "Физика",
      "grade_level": 8,
      "description": "Закон Ома для участка цепи: $I=\\frac{U}{R}$. Сила тока прямо пропорциональна напряжению и обратно пропорциональна сопротивлению.",
      "subtopics": {
        "Закон Ома для участка цепи": "Эквивалентные формы закона Ома: $U=IR$ и $R=\\frac{U}{I}$."
      }
    },
    {
      "name": "Равноускоренное движение",
      "subject": "Физика",
      "grade_level": 9,
      "description": "Ускорение характеризует изменение скорости: $a=\\frac{v-v_0}{t}$. При постоянном ускорении $v=v_0+at$.",
      "subtopics": {
        "Ускорение": "Знак ускорения зависит от выбранного направления оси и характера изменения проекции скорости."
      }
    },
    {
      "name": "Законы Ньютона",
      "subject": "Физика",
      "grade_level": 9,
      "description": "Второй закон Ньютона связывает равнодействующую сил с ускорением тела: $\\vec F=m\\vec a$.",
      "subtopics": {
        "Второй закон Ньютона": "Перед применением закона следует найти векторную сумму всех сил, действующих на тело."
      }
    }
  ],
